#!/usr/bin/env bash

is_interface_name() {
    [[ ${1:-} =~ ^[a-zA-Z0-9_.:-]+$ ]]
}

is_ipv4_address() {
    local value=${1:-}
    local octet
    local octets=()
    IFS=. read -r -a octets <<< "$value"
    (( ${#octets[@]} == 4 )) || return 1
    for octet in "${octets[@]}"; do
        [[ $octet =~ ^[0-9]{1,3}$ ]] || return 1
        (( 10#$octet <= 255 )) || return 1
    done
}

is_ipv4_cidr() {
    local value=${1:-}
    [[ $value == */* ]] || return 1
    local address=${value%/*}
    local prefix=${value#*/}
    [[ $prefix =~ ^[0-9]{1,2}$ ]] || return 1
    (( 10#$prefix <= 32 )) || return 1
    is_ipv4_address "$address"
}

read_ipv4_targets() {
    local value=$1
    local output_name=$2
    local -n output=$output_name
    read -r -a output <<< "$value"
    (( ${#output[@]} > 0 )) || return 1
    local target
    for target in "${output[@]}"; do
        is_ipv4_cidr "$target" || return 1
    done
}

vpn_server_host() {
    local url=${1:-}
    [[ $url =~ ^https://[^[:space:]]+$ ]] || return 1
    local host=${url#https://}
    host=${host%%/*}
    host=${host%%:*}
    [[ -n $host ]] || return 1
    printf '%s\n' "$host"
}

append_route_arguments() {
    local targets_name=$1
    local arguments_name=$2
    local -n vpn_targets_ref=$targets_name
    local -n vpn_arguments_ref=$arguments_name
    local target
    for target in "${vpn_targets_ref[@]}"; do
        vpn_arguments_ref+=(--route "$target")
    done
}

render_nft_rules() {
    local table_name=$1
    local uplink_interface=$2
    local tunnel_interface=$3
    shift 3
    local targets=("$@")
    is_interface_name "$uplink_interface" || return 2
    is_interface_name "$tunnel_interface" || return 2
    (( ${#targets[@]} > 0 )) || return 2
    local elements=""
    local target
    for target in "${targets[@]}"; do
        is_ipv4_cidr "$target" || return 2
        elements+="${elements:+, }$target"
    done
    cat <<EOF
table inet $table_name {
    set targets {
        type ipv4_addr
        flags interval
        elements = { $elements }
    }
    chain forward {
        type filter hook forward priority filter
        policy drop
        ct state established,related accept
        iifname "$uplink_interface" oifname "$tunnel_interface" ip daddr @targets accept
    }
    chain postrouting {
        type nat hook postrouting priority srcnat
        policy accept
        oifname "$tunnel_interface" ip daddr @targets masquerade
    }
}
EOF
}
